#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // 右親指 上（単押し Enter / 長押しレイヤー3）用の1キー2役。
        // quick-tap-ms があるので、単押ししたあと素早く押し直して押しっぱなしにすると
        // レイヤーに入らず連打になる。
        // 誤爆するようなら tapping-term-ms を上げ下げして調整する。
        lt_q: layer_tap_quick {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        // Windows と macOS で IME 切替のキーコードが違うので両方送る。
        // 相手の OS が知らない方は無視される。
        //   Windows: 無変換 = INT5 / 変換 = INT4
        //   macOS  : 英数   = LANG2 / かな = LANG1
        ime_eisu: ime_eisu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp INT5 &kp LANG2>;
        };

        ime_kana: ime_kana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp INT4 &kp LANG1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ベース。
        //   行0 … Y U I O P BackSpace   （右端の上下が BackSpace / Enter）
        //   行1 … H J K L ; Enter
        //   行2 … N M , . / _
        //   行3 … かな [ ] ろ           （矢印はレイヤー2・3へ）
        // 押し出された @ と : はレイヤー2 の同じ物理キーに乗せてある
        // （レイヤー2 ＋ BackSpace = @ ／ レイヤー2 ＋ Enter = :）。
        // 親指は 左上=Space / 左下=レイヤー2（素） / 右上=Enter・長押しL3 / 右下=レイヤー2（素）。
        // レイヤー2 は左右どちらの親指からでも入れる。単押しでは何も出ない。
        // ⚠ 行2 右端を _ にしたので右 Shift は無い。左 Shift のみ。
        layer_0 {
            bindings = <
&kp TAB    &kp Q       &kp W   &kp E     &kp R      &kp T      &kp Y      &kp U        &kp I      &kp O      &kp P      &kp BSPC
&kp LCTRL  &kp A       &kp S   &kp D     &kp F      &kp G      &kp H      &kp J        &kp K      &kp L      &kp SEMI   &kp RET
&kp LSHFT  &kp Z       &kp X   &kp C     &kp V      &kp B      &kp SPACE  &lt_q 3 RET  &kp N      &kp M      &kp COMMA  &kp DOT   &kp SLASH  &kp LS(INT1)
&kp LGUI   &kp ESCAPE  &mo 5   &kp LALT  &ime_eisu  &kp SPACE  &mo 2      &mo 2        &ime_kana  &kp RBKT   &kp NUHS   &kp INT1
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &mkp MCLK     &trans          &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mo 4         &mkp RCLK       &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans        &kp LA(LEFT)    &kp LG(TAB)    &kp LA(RIGHT)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans        &trans          &trans         &trans
            >;
        };

        // 数字段＋矢印レイヤー。
        //   右手 … 標準 JIS の数字段を1行そのまま。8 9 0 の真下に - ^ ¥ が続く。
        //          右端の上下は @ と : （ベースで BackSpace / Enter がある物理キー）。
        //   左手 … 1 2 3 の真下に Home ↑ End、そのまた下に ← ↓ →。
        // 左手の矢印を使うときは右親指の下（BSpc）を長押しして入ると両手に分かれる。
        // ! " # $ % & ' ( ) = ~ | は Shift を足せば標準どおり出るので専用キーは置かない。
        layer_2 {
            bindings = <
&kp ESCAPE  &kp N1          &kp N2            &kp N3           &kp N4  &kp N5  &kp N6  &kp N7  &kp N8     &kp N9     &kp N0    &kp LBKT
&trans      &kp HOME        &kp UP_ARROW      &kp END          &trans  &trans  &trans  &trans  &kp MINUS  &kp EQUAL  &kp INT3  &kp SQT
&trans      &kp LEFT_ARROW  &kp DOWN_ARROW    &kp RIGHT_ARROW  &trans  &trans  &trans  &trans  &trans     &trans     &trans    &trans   &trans  &trans
&trans      &trans          &trans            &trans           &trans  &trans  &trans  &trans  &trans     &trans     &trans    &kp DELETE
            >;
        };

        layer_3 {
            bindings = <
&kp F1        &kp HOME      &kp UP_ARROW     &kp END         &kp F2            &kp F5        &trans        &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans        &kp LEFT_ARROW &kp DOWN_ARROW  &kp RIGHT_ARROW &kp F11           &kp F12       &kp F3        &trans         &kp KP_MINUS     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans        &kp F6        &kp F7           &kp F8          &kp F9            &kp F10       &trans        &trans         &kp F4           &trans           &kp LS(LBKT)     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2     &bt BT_SEL 3    &bt BT_SEL 4      &out OUT_USB  &out OUT_BLE  &trans         &trans           &kp KP_NUMBER_0  &kp DOT          &kp KP_EQUAL
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // テンキー。入口は L0 最下段の &mo 5（左中指）。
        // 左手で保持して右手だけで打てるように、右手ホーム位置に数字を寄せてある。
        // 人差し指=7/4/1、中指=8/5/2、薬指=9/6/3、小指=演算子。
        // 親指は透過のままなので Space / Enter / BackSpace はいつもどおり使える。
        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans           &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_PLUS      &kp KP_EQUAL
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
