#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        // 英数（IME オフ）だけは両 OS のコードを続けて送れる。
        //   Windows: 無変換 = INT5   （LANG2 は Windows では何もしないので無害）
        //   macOS  : 英数   = LANG2  （INT5 は macOS が無視する）
        //
        // ⚠ かな側は同じ手が使えない。Windows は LANG1 を無視せず
        //   「入力モードを1つ進める」キーとして解釈するため、押すたびに
        //   全角カナ → 半角カナ → ひらがな と巡回してしまう（実機で確認済み）。
        //   そのため かな は OS ごとに分けてある：
        //     ベース    = &kp INT4   （Windows。これだけで確実にひらがな）
        //     レイヤー6 = &kp LANG1  （macOS。&tog 6 で切り替える Mac モード）
        ime_eisu: ime_eisu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp INT5 &kp LANG2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ベース。
        //   行0 … Y U I O P BackSpace   （右端の上下が BackSpace / Enter）
        //   行1 … H J K L ; Enter
        //   行2 … N M , . / _
        //   行3 … かな [ ] ろ           （矢印はレイヤー2・3へ）
        // 押し出された @ と : はレイヤー2 の同じ物理キーに乗せてある
        // （レイヤー2 ＋ BackSpace = @ ／ レイヤー2 ＋ Enter = :）。
        // 親指は 左上=Space / 左下=レイヤー2 / 右上=かな / 右下=レイヤー3。
        // Enter は行1の右端、BackSpace は行0の右端にある（親指には無い）。
        // かなは親指と最下段の2箇所。どちらも Mac モードで LANG1 に差し替わる。
        // ⚠ 行2 右端を _ にしたので右 Shift は無い。左 Shift のみ。
        layer_0 {
            bindings = <
&kp TAB    &kp Q       &kp W   &kp E     &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSPC
&kp LCTRL  &kp A       &kp S   &kp D     &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp RET
&kp LSHFT  &kp Z       &kp X   &kp C     &kp V      &kp B      &kp SPACE  &kp INT4   &kp N      &kp M      &kp COMMA  &kp DOT   &kp SLASH  &kp LS(INT1)
&kp LGUI   &kp ESCAPE  &mo 5   &kp LALT  &ime_eisu  &kp SPACE  &mo 2      &mo 3      &kp INT4   &kp RBKT   &kp NUHS   &kp INT1
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &mkp MCLK     &trans          &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mo 4         &mkp RCLK       &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans        &kp LA(LEFT)    &kp LG(TAB)    &kp LA(RIGHT)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans        &trans          &trans         &trans
            >;
        };

        // 記号・矢印レイヤー。入口は左親指の下。
        //   左手 … W E R の段に Home ↑ End、ホーム段（S D F）に ← ↓ →。
        //          指をホームから動かさずにカーソル移動できる。
        //   右手 … 最上段の右端に - ^ ¥（標準 JIS の数字段の尻尾）。
        //          その下に @、さらに下に : （標準 JIS と同じ上下関係）。
        //   右端の行1・行2 を透過にしてあるので、押さえたまま Enter と BackSpace が使える。
        // 数字は廃止。Shift を足す記号（! " # $ % など）も同様。
        layer_2 {
            bindings = <
&kp ESCAPE  &trans  &kp HOME        &kp UP_ARROW    &kp END          &trans  &trans  &trans  &trans  &kp MINUS  &kp EQUAL  &kp INT3
&trans      &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &trans  &trans  &trans     &kp LBKT   &trans
&trans      &trans  &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans     &trans     &trans  &kp SQT  &trans
&trans      &trans  &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans     &trans     &kp DELETE
            >;
        };

        // Fn・数字・Bluetooth。入口は右親指の下。
        // 数字は右手のホームポジションに揃えてある（5 が K、0 が かな の位置）。
        // ⚠ ここは KP_ ではなく普通の 1〜0。NumLock に左右されず、
        //   さらに 左Shift を足すだけで ! " # $ % & ' ( ) が標準どおり出る。
        //   本物のテンキー（KP_）が要るときはレイヤー5 を使う。
        // 演算子だけは KP_ のまま（JIS でもズレないため）。
        layer_3 {
            bindings = <
&kp F1        &kp HOME        &kp UP_ARROW    &kp END          &kp F2        &kp F5        &tog 6        &kp N7  &kp N8  &kp N9  &kp KP_DIVIDE    &trans
&trans        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp F11       &kp F12       &kp F3        &kp N4  &kp N5  &kp N6  &kp KP_MULTIPLY  &trans
&trans        &kp F6          &kp F7          &kp F8           &kp F9        &kp F10       &trans        &trans  &kp F4  &kp N1  &kp N2           &kp N3  &kp KP_MINUS  &trans
&bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4  &out OUT_USB  &out OUT_BLE  &trans  &kp N0  &kp DOT  &kp KP_PLUS     &kp KP_EQUAL
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // テンキー。入口は L0 最下段の &mo 5（左中指）。
        // 左手で保持して右手だけで打てるように、右手ホーム位置に数字を寄せてある。
        // 人差し指=7/4/1、中指=8/5/2、薬指=9/6/3、小指=演算子。
        // 親指は透過のままなので Space / Enter / BackSpace はいつもどおり使える。
        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans           &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_PLUS      &kp KP_EQUAL
            >;
        };

        // Mac モード。入口は レイヤー3 の M の位置にある &tog 6（押すたびに ON/OFF）。
        // かな 2箇所（右親指 上 と 最下段）を macOS 用の LANG1 に差し替える。他は全部透過。
        // ⚠ 戻し忘れたまま Windows で かな を押すと IME が全く反応しない
        //    （変換を送らなくなるため）。すぐ気づけるので、その場で戻すこと。
        // ⚠ レイヤーの状態は保存されないので、電源を切ると自動的に OFF に戻る。
        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans      &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans      &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &kp LANG1  &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LANG1   &trans  &trans  &trans
            >;
        };
    };
};
