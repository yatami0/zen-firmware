#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        // Windows と macOS で IME 切替のキーコードが違うので両方送る。
        // 相手の OS が知らない方は無視される。
        //   Windows: 無変換 = INT5 / 変換 = INT4
        //   macOS  : 英数   = LANG2 / かな = LANG1
        ime_eisu: ime_eisu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp INT5 &kp LANG2>;
        };

        ime_kana: ime_kana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp INT4 &kp LANG1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB    &kp Q       &kp W   &kp E     &kp R     &kp T  &kp Y      &kp U     &kp I     &kp O           &kp P           &kp LBKT
&kp LSHFT  &kp A       &kp S   &kp D     &kp F     &kp G  &kp H      &kp J     &kp K     &kp L           &kp SEMI        &kp SQT
&kp LCTRL  &kp Z       &kp X   &kp C     &kp V     &kp B  &kp SPACE  &mo 3     &kp N     &kp M           &kp COMMA       &kp DOT          &kp UP_ARROW  &mt RSHFT QUESTION
&kp LGUI   &kp ESCAPE  &none   &kp LALT  &ime_eisu  &mo 2  &kp RET    &kp BSPC  &ime_kana  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &mkp MCLK     &trans          &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mo 4         &mkp RCLK       &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans        &kp LA(LEFT)    &kp LG(TAB)    &kp LA(RIGHT)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans        &trans          &trans         &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &kp N1     &kp N2     &kp N3    &kp N4      &kp N5        &kp N6     &kp N7         &kp N8     &kp N9                &kp N0           &kp DELETE
&trans      &kp EXCL   &kp AT     &kp HASH  &kp DOLLAR  &kp PRCNT     &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp LS(MINUS)    &kp LS(EQUAL)
&trans      &kp MINUS  &kp EQUAL  &kp INT3  &kp INT1    &kp LS(LBKT)  &trans     &trans         &kp RBKT   &kp NUHS              &kp RIGHT_BRACE  &kp LS(NUHS)   &kp LS(INT1)  &kp LS(INT3)
&trans      &trans     &trans     &trans    &trans      &trans        &trans     &trans         &trans     &trans                &trans           &trans
            >;
        };

        layer_3 {
            bindings = <
&kp F1        &kp F2        &kp HOME         &kp UP_ARROW    &kp END           &kp F5        &trans        &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans        &kp F11       &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW   &kp F12       &kp F3        &trans         &kp KP_MINUS     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans        &kp F6        &kp F7           &kp F8          &kp F9            &kp F10       &trans        &trans         &kp F4           &trans           &kp LS(LBKT)     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2     &bt BT_SEL 3    &bt BT_SEL 4      &out OUT_USB  &out OUT_BLE  &trans         &trans           &kp KP_NUMBER_0  &kp DOT          &kp KP_EQUAL
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
